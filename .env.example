# Copia este archivo a .env.local (no se sube a git) y completa los valores.
# Sin estas variables el formulario sigue funcionando: solo abre WhatsApp con la solicitud.

# API key de Resend (https://resend.com/api-keys). Activa el envío de una copia por correo.
RESEND_API_KEY=

# Correo que recibe las solicitudes. Si se omite, usa contact.email de components/data/site.jsx.
CONTACT_TO_EMAIL=pok.merida@gmail.com

# Remitente. Debe ser un dominio verificado en Resend; para pruebas sirve onboarding@resend.dev.
CONTACT_FROM_EMAIL=POK Web <onboarding@resend.dev>
