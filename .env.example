# Copia este archivo a .env.local y rellena los valores. .env.local no se sube a git.

# Contraseña de aplicación de Gmail (Cuenta de Google > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones).
# Sin esta variable el formulario no envía correo y ofrece WhatsApp como alternativa.
GMAIL_APP_PASSWORD=

# Opcionales: por defecto se usa el correo de components/data/site.jsx (contact.email)
# GMAIL_USER=pok.merida@gmail.com
# QUOTE_TO_EMAIL=pok.merida@gmail.com
